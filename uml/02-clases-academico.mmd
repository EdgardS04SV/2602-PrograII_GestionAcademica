classDiagram

class Usuario {
    -int idUsuario
    -String nombreUsuario
    -boolean estado
    +esEstudiante() boolean
    +esInstructor() boolean
}

class PeriodoAcademico {
    -int idPeriodo
    -String nombrePeriodo
    -LocalDate fechaInicio
    -LocalDate fechaFin
    -EstadoPeriodo estado
    +activar()
    +finalizar()
    +validarFechas() boolean
    +estaVigente() boolean
}

class Curso {
    -int idCurso
    -String codigoCurso
    -String nombreCurso
    -String descripcion
    -EstadoCurso estado
    +asignarInstructor(Usuario instructor)
    +matricularEstudiante(Usuario estudiante)
    +agregarMaterial(MaterialDidactico material)
    +agregarActividad(ActividadEvaluativa actividad)
    +obtenerEstudiantes()
    +calcularPromedio() double
}

class Matricula {
    -int idMatricula
    -LocalDate fechaMatricula
    +registrar()
    +cancelar()
    +estaActiva() boolean
}

class MaterialDidactico {
    -int idMaterial
    -String tituloMaterial
    -String rutaArchivo
    -LocalDate fechaSubida
    +publicar()
    +descargar()
}

class ActividadEvaluativa {
    -int idActividad
    -String nombreActividad
    -String descripcion
    -LocalDate fechaLimite
    -double ponderacion
    +publicar()
    +estaVencida() boolean
    +recibirEntrega(EntregaEvaluacion entrega)
}

class EntregaEvaluacion {
    -int idEntrega
    -String rutaArchivoEntrega
    -LocalDate fechaEntrega
    -double calificacion
    -String observaciones
    +entregar()
    +calificar(double nota, String observaciones)
    +estaCalificada() boolean
}

class EstadoPeriodo {
    <<enumeration>>
    PLANIFICADO
    ACTIVO
    FINALIZADO
}

class EstadoCurso {
    <<enumeration>>
    INACTIVO
    ACTIVO
}

PeriodoAcademico "1" <-- "0..*" Curso : contiene

Usuario "0..1" <-- "0..*" Curso : instructor

Usuario "1" <-- "0..*" Matricula : estudiante
Curso "1" <-- "0..*" Matricula : curso

Curso "1" *-- "0..*" MaterialDidactico : contiene

Curso "1" *-- "0..*" ActividadEvaluativa : contiene

ActividadEvaluativa "1" *-- "0..*" EntregaEvaluacion : recibe

Usuario "1" <-- "0..*" EntregaEvaluacion : realiza

PeriodoAcademico --> EstadoPeriodo
Curso --> EstadoCurso